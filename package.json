{
  "name": "aster",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/project-database.mjs local",
    "setup": "node scripts/setup.mjs",
    "check": "pnpm project:check --if-present && pnpm locale:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:starter",
    "admin:grant": "node scripts/admin.mjs grant",
    "admin:revoke": "node scripts/admin.mjs revoke",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "locale:check": "node scripts/check-locales.mjs",
    "test:production": "node scripts/test-production.mjs",
    "starter:new": "node skills/aster-new/scripts/create-project.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "test:starter": "node --test tests/starter/*.test.mjs",
    "project:doctor": "node scripts/project.mjs doctor",
    "project:status": "node scripts/project.mjs status",
    "project:check": "node scripts/project.mjs check",
    "project:resume": "node scripts/project-resume.mjs",
    "project:upgrade": "node scripts/project-upgrade.mjs",
    "aster:new": "node skills/aster-new/scripts/create-project.mjs",
    "project:service": "node scripts/project-service.mjs",
    "project:modules": "node scripts/project-modules.mjs",
    "project:database": "node scripts/project-database.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3",
    "jsonc-parser": "3.3.1"
  }
}
